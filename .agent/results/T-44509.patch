+        ? {
+            status: "partial",
+            data: rows,
+            filter: { label: "Retry snapshot", clear: retry },
+            totalCount: shown.length,
+          }
+        : rows.length > 0
+          ? { status: "populated", data: rows }
+          : { status: "empty", reason: "no-data" };
+
