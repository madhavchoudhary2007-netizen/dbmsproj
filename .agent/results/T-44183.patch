@@ -0,0 +1,47 @@
+export const ROLE_STRING = "#FFFDF5,#FFFFFF,#FF6B6B";
+
+const roles = [[255, 253, 245], [255, 255, 255], [255, 107, 107]] as const;
+
+export function scorePixels(data: Uint8Array, channels: number): { share: number[]; ok: boolean } {
+  const counts = [0, 0, 0];
+  let total = 0;
+  if (Number.isInteger(channels) && channels >= 3) {
+    for (let i = 0; i + 2 < data.length; i += channels) {
+      let best = -1;
+      let bestD = Infinity;
+      roles.forEach((role, k) => {
+        const d = (role[0] - data[i]) ** 2 + (role[1] - data[i + 1]) ** 2 + (role[2] - data[i + 2]) ** 2;
+        if (d < bestD) { bestD = d; best = k; }
+      });
+      if (bestD <= 900) { counts[best]++; total++; }
+    }
+  }
+  const share = total ? counts.map(count => count / total) : [0, 0, 0];
+  const ok = total > 0 && share[0] >= 0.5 && share[0] <= 0.7 && share[1] >= 0.2 && share[1] <= 0.4 && share[2] >= 0.05 && share[2] <= 0.15;
+  return { share, ok };
+}
+
+export function selfTest(): void {
+  const pixels = (...rgb: number[][]): Uint8Array => new Uint8Array(rgb.flat());
+  const repeat = (rgb: number[], count: number): number[][] => Array.from({ length: count }, () => rgb);
+  const check = (condition: boolean, label: string): void => { if (!condition) throw new Error(`palette self-test failed: ${label}`); };
+  const test = (cream: number, white: number, red: number): { share: number[]; ok: boolean } =>
+    scorePixels(pixels(...repeat([255, 253, 245], cream), ...repeat([255, 255, 255], white), ...repeat([255, 107, 107], red)), 3);
+
+  check(test(60, 30, 10).ok, "60/30/10 passes");
+  check(test(50, 40, 10).ok && test(70, 20, 10).ok, "dominant inclusive bounds");
+  check(!test(49, 40, 11).ok && !test(71, 20, 9).ok, "dominant outside bounds fails");
+  check(test(65, 20, 15).ok && test(65, 25, 10).ok, "secondary lower boundary and interior");
+  check(test(50, 40, 10).ok && !test(70, 19, 11).ok && !test(50, 41, 9).ok, "secondary upper boundary and outside bounds");
+  check(test(70, 25, 5).ok && test(50, 35, 15).ok, "accent inclusive bounds");
+  check(!test(60, 36, 4).ok && !test(50, 30, 20).ok, "accent outside bounds fails");
+
+  const separated = scorePixels(pixels(...repeat([255, 253, 245], 60), ...repeat([255, 255, 255], 30), ...repeat([255, 107, 107], 10)), 3);
+  check(separated.share[0] === 0.6 && separated.share[1] === 0.3, "cream and white remain separate at distance squared 104");
+  const withBlack = scorePixels(pixels(...repeat([0, 0, 0], 10), ...repeat([255, 253, 245], 60), ...repeat([255, 255, 255], 30), ...repeat([255, 107, 107], 10)), 3);
+  check(withBlack.ok && withBlack.share[0] === 0.6, "black is excluded from counted denominator");
+  const empty = scorePixels(pixels(...repeat([0, 0, 0], 3)), 3);
+  check(!empty.ok && empty.share.every(value => value === 0), "no counted pixels fails without NaN");
+  const atThreshold = scorePixels(pixels(...repeat([255, 253, 245], 50), ...repeat([255, 255, 255], 30), ...repeat([255, 107, 107], 9), [225, 107, 107]), 3);
+  check(atThreshold.ok && Math.abs(atThreshold.share[2] - 1 / 9) < 1e-12, "distance squared 900 is inclusive");
+}
