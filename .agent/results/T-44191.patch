+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from backend.tests.contract_compat import assert_compatible
+
+
+def _param(name="q", location="query", required=False):
+    return {"name": name, "in": location, "required": required, "schema": {"type": "string"}}
+
+
+def _body(required=False, schema=None):
+    return {
+        "required": required,
+        "content": {"application/json": {"schema": schema or {"type": "object"}}},
+    }
+
+
+def _doc(path=(), op=(), body=None, schemas=None):
+    operation = {"responses": {"204": {}}}
+    if op:
+        operation["parameters"] = list(op)
+    if body is not None:
+        operation["requestBody"] = body
+    item = {"post": operation}
+    if path:
+        item["parameters"] = list(path)
+    result = {"openapi": "3.0.0", "paths": {"/items": item}}
+    if schemas:
+        result["components"] = {"schemas": schemas}
+    return result
+
+
+def _ref_doc(required=()):
+    return _doc(
+        body=_body(schema={"$ref": "#/components/schemas/Envelope"}),
+        schemas={
+            "Envelope": {
+                "type": "object",
+                "properties": {"meta": {"$ref": "#/components/schemas/Meta"}},
+            },
+            "Meta": {
+                "type": "object",
+                "required": list(required),
+                "properties": {"trace": {"type": "string"}},
+            },
+        },
+    )
+
+
+@pytest.mark.parametrize(
+    ("old", "new", "message"),
+    [
+        (_doc(), _doc(op=[_param(required=True)]), "required parameter"),
+        (_doc(), _doc(op=[_param("X-Token", "header", True)]), "required parameter"),
+        (_doc(op=[_param()]), _doc(op=[_param(required=True)]), "required parameter"),
+        (_doc(), _doc(path=[_param("page", required=True)]), "required parameter"),
+        (
+            _doc(path=[_param()]),
+            _doc(path=[_param()], op=[_param(required=True)]),
+            "required parameter",
+        ),
+        (_doc(), _doc(body=_body(True)), "required request body"),
+        (_doc(body=_body()), _doc(body=_body(True)), "required request body"),
+        (
+            _doc(body=_body()),
+            _doc(
+                body=_body(
+                    schema={
+                        "type": "object",
+                        "required": ["token"],
+                        "properties": {"token": {"type": "string"}},
+                    }
+                )
+            ),
+            "required.*field",
+        ),
+        (_ref_doc(), _ref_doc(["trace"]), "required.*field"),
+    ],
+)
+def test_new_request_requirements_break_compatibility(old, new, message):
+    with pytest.raises(AssertionError, match=message):
+        assert_compatible(old, new)
+
+
+def test_optional_additions_and_unchanged_contracts_are_compatible():
+    schema = {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}
+    old = _doc(op=[_param(required=True)], body=_body(True, schema))
+    new = _doc(
+        op=[_param(required=True), _param("locale")],
+        body=_body(
+            True, {**schema, "properties": {**schema["properties"], "label": {"type": "string"}}}
+        ),
+    )
+    assert_compatible(old, new)
+
+
+def test_widening_accepted_request_values_is_compatible():
+    def param(values):
+        return {"name": "mode", "in": "query", "schema": {"type": "string", "enum": values}}
+
+    def body(values):
+        return _body(
+            schema={"type": "object", "properties": {"mode": {"type": "string", "enum": values}}}
+        )
+
+    assert_compatible(
+        _doc(op=[param(["a"])], body=body(["a"])),
+        _doc(op=[param(["a", "b"])], body=body(["a", "b"])),
+    )
