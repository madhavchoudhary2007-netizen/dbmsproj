diff --git a/backend/tests/test_api.py b/backend/tests/test_api.py
index 55749d2..c476b13 100644
--- a/backend/tests/test_api.py
+++ b/backend/tests/test_api.py
@@ -2809,3 +2809,67 @@ def test_principal_ownership_and_telemetry_ingest_policy(database_api_client):
         "/api/telemetry/ingest", headers=admin_headers, json=telemetry_packet
     )
     assert admin_rejected.status_code == 409
+
+
+@pytest.mark.skipif(
+    os.environ.get("APEXGRID_TEST_STACK") != "1", reason="requires disposable stack"
+)
+def test_stewarding_reads_match_official_database_rows(database_api_client):
+    from backend.app.core.request_auth import current_user
+
+    app = main_module.app
+    missing = object()
+    prior = app.dependency_overrides.get(current_user, missing)
+    app.dependency_overrides[current_user] = lambda: {"id": "integration-viewer", "role": "STEWARD"}
+    try:
+        penalty_sql = (
+            "SELECT p.id, p.incident_id, p.driver_id, u.full_name AS driver_name, "
+            "i.session_id, i.lap, p.points, p.time_seconds, p.grid_places, p.created_at "
+            "FROM penalties p JOIN incident_reports i ON i.id = p.incident_id "
+            "LEFT JOIN drivers d ON d.id = p.driver_id LEFT JOIN users u ON u.id = d.user_id "
+            "ORDER BY p.created_at DESC, p.id DESC LIMIT %s OFFSET %s"
+        )
+        expected_penalties = main_module.jsonable(main_module.fetch_all(penalty_sql, (200, 0)))
+        penalties = database_api_client.get("/api/stewarding/penalties?limit=200")
+        penalty_rows = penalties.json()
+        assert penalties.status_code == 200 and isinstance(penalty_rows, list)
+        for actual, expected in zip(penalty_rows, expected_penalties, strict=True):
+            assert actual == expected
+            created_at = datetime.fromisoformat(actual["created_at"].replace("Z", "+00:00"))
+            expected_at = datetime.fromisoformat(expected["created_at"].replace("Z", "+00:00"))
+            assert created_at == expected_at and created_at.utcoffset() == timedelta(0)
+            assert isinstance(actual["points"], int)
+        historical_season = 2020
+        licence_sql = (
+            "SELECT d.id AS driver_id, u.full_name AS driver_name, d.licence_number, "
+            "d.eligibility, "
+            "%s AS season, CASE WHEN pp.driver_id IS NULL THEN 0 ELSE pp.points END AS points, "
+            "pp.driver_id AS penalty_points_driver_id FROM drivers d "
+            "LEFT JOIN users u ON u.id = d.user_id "
+            "LEFT JOIN penalty_points pp ON pp.driver_id = d.id AND pp.season = %s "
+            "ORDER BY d.id ASC LIMIT %s OFFSET %s"
+        )
+        expected_licences = main_module.jsonable(
+            main_module.fetch_all(licence_sql, (historical_season, historical_season, 200, 0))
+        )
+        licences = database_api_client.get(
+            f"/api/stewarding/licences?season={historical_season}&limit=200"
+        )
+        assert licences.status_code == 200
+        licence_rows = licences.json()
+        assert isinstance(licence_rows, list)
+        for actual, expected in zip(licence_rows, expected_licences, strict=True):
+            penalty_points_driver_id = expected.pop("penalty_points_driver_id")
+            assert actual == expected
+            assert isinstance(actual["points"], int)
+            if penalty_points_driver_id is None:
+                assert actual["points"] == 0
+
+        default_licences = database_api_client.get("/api/stewarding/licences?limit=200")
+        assert default_licences.status_code == 200
+        assert all(row["season"] == datetime.now(UTC).year for row in default_licences.json())
+    finally:
+        if prior is missing:
+            app.dependency_overrides.pop(current_user, None)
+        else:
+            app.dependency_overrides[current_user] = prior
