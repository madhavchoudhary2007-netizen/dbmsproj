diff --git a/scripts/eval/neo_gradient.py b/scripts/eval/neo_gradient.py
new file mode 100644
index 0000000..177a7f3
--- /dev/null
+++ b/scripts/eval/neo_gradient.py
@@ -0,0 +1,128 @@
+import posixpath
+import re
+import sys
+from pathlib import Path
+
+from scripts.eval.neo_effects import _inside_string, _value_end
+from scripts.eval.source_text import mask_comments
+
+GRADIENT = re.compile(r"(?<![\w-])(?:repeating-)?(?:linear|radial|conic)-gradient\s*\(", re.I)
+PROPERTY = re.compile(
+    r"(?P<key>['\"](?P<quoted>background(?:Image)?|mask(?:Image)?|[\w-]+)['\"]|"
+    r"(?P<plain>--[\w-]+|[\w-]+))\s*:",
+    re.I,
+)
+TAILWIND = re.compile(
+    r"(?<![\w-])(?:[\w-]+:)*(?:bg-gradient-to-[\w-]+|bg-linear(?:-[\w-]+)?|"
+    r"bg-radial(?:-[\w-]+)?|bg-conic(?:-[\w-]+)?|"
+    r"bg-\[[^\]\s]+\])(?![\w-])",
+    re.I,
+)
+STYLE_KEYS = {"background", "backgroundimage", "mask", "maskimage"}
+
+
+def _allowed_path(path: str) -> bool:
+    normalized = posixpath.normpath(path.replace("\\", "/"))
+    return normalized == "frontend/app/styles/textures.css" or (
+        posixpath.isabs(normalized) and normalized.endswith("/frontend/app/styles/textures.css")
+    )
+
+
+def _gradients(value: str, offset: int, allow_quoted: bool) -> list[int]:
+    offset += len(value) - len(value.lstrip())
+    value = value.strip()
+    if allow_quoted and value and value[0] in "'\"`":
+        quote = value[0]
+        end = value.find(quote, 1)
+        if end >= 0:
+            offset += 1
+            value = value[1:end]
+    return [
+        offset + match.start()
+        for match in GRADIENT.finditer(value)
+        if not _inside_string(value, match.start())
+    ]
+
+
+def _utility_regions(text: str) -> list[tuple[int, int]]:
+    attrs = re.finditer(r"\bclass(?:Name)?\s*=\s*\{?(['\"`])(.*?)\1\}?", text, re.S)
+    applies = re.finditer(r"@apply\s+", text)
+    return [(m.start(2), m.end(2)) for m in attrs] + [
+        (m.end(), text.find(";", m.end()) if ";" in text[m.end() :] else len(text)) for m in applies
+    ]
+
+
+def check_gradients(text: str, path: str, css: bool = False) -> list[tuple[int, str]]:
+    if _allowed_path(path):
+        return []
+    clean = mask_comments(text, css=css)
+    hits: list[tuple[int, str]] = []
+    for match in PROPERTY.finditer(clean):
+        key = match.group("quoted") or match.group("plain") or ""
+        if not css and (
+            _inside_string(clean, match.start())
+            or key.lower().replace("-", "") not in STYLE_KEYS
+            and not key.startswith("--")
+        ):
+            continue
+        start = match.end()
+        hits.extend(
+            (n, "gradient function in declaration")
+            for n in _gradients(
+                clean[start : _value_end(clean, start)], start, allow_quoted=not css
+            )
+        )
+    for start, end in _utility_regions(clean):
+        for match in TAILWIND.finditer(clean[start:end]):
+            if not match.group().startswith("bg-[") or GRADIENT.search(match.group()):
+                hits.append((start + match.start(), "gradient utility"))
+    return sorted(set(hits))
+
+
+def _expect(condition: bool) -> None:
+    if not condition:
+        raise AssertionError("gradient rule self-test failed")
+
+
+def _self_test() -> None:
+    root = Path(__file__).with_name("rules")
+    good = (root / "gradient.good.css").read_text()
+    bad = (root / "gradient.bad.css").read_text()
+    _expect(
+        not check_gradients(good, "frontend/app/styles/textures.css", css=True)
+        and len(check_gradients(bad, "frontend/app/styles/globals.css", css=True)) == 8
+    )
+    css_source = (
+        "a{background:linear-gradient(x);--x:radial-gradient(y);"
+        "mask:repeating-conic-gradient(z);color:conic-gradient(w)}"
+    )
+    _expect(len(check_gradients(css_source, "x.css", css=True)) == 4)
+    js_source = "({backgroundImage:'linear-gradient(x)','maskImage':'radial-gradient(y)'})"
+    _expect(len(check_gradients(js_source, "x.js")) == 2)
+    utility = (
+        "<div className='bg-gradient-to-r bg-linear-to-r bg-radial bg-conic "
+        "bg-[linear-gradient(red,blue)]' />"
+    )
+    _expect(len(check_gradients(utility, "x.tsx")) == 5)
+    solid = '<div className="bg-[#FFFDF5]" />'
+    _expect(not check_gradients(solid, "x.tsx"))
+    control = "/* gradient */ .x{background:url(x/linear-gradient);content:'linear-gradient'}"
+    _expect(not check_gradients(control, "x.css", css=True))
+    _expect(not check_gradients('const note = "background: linear-gradient(x)"', "x.js"))
+    source = "/*x*/a{background:linear-gradient(red,blue)}"
+    bad_paths = (
+        "other/frontend/app/styles/textures.css",
+        "frontend/app/styles/textures.css.evil",
+        "other/textures.css",
+    )
+    _expect(all(check_gradients(source, path, css=True) for path in bad_paths))
+    _expect(check_gradients(source, "x.css", True)[0][0] == source.index("linear"))
+    for path in ("frontend/app/styles/textures.css", "/repo/frontend/app/styles/textures.css"):
+        _expect(not check_gradients(source, path, True))
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--self-test"]:
+        _self_test()
+    else:
+        raise SystemExit("usage: neo_gradient.py --self-test")
