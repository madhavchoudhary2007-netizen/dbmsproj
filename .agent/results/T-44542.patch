+import AxeBuilder from "@axe-core/playwright";
+import { expect, test } from "./mock-platform";
+import type { Page } from "@playwright/test";
+
+const season = new Date().getUTCFullYear();
+const driver = (id: string, name: string, points: number) => ({
+  driver_id: id, driver_name: name, licence_number: `LIC-${id}`, eligibility: "ELIGIBLE", season, points,
+});
+const penalty = (id: string, driver_id: string, driver_name: string) => ({
+  id, incident_id: `incident-${id}`, driver_id, driver_name, session_id: "session-1", lap: 18,
+  points: 3, time_seconds: 5, grid_places: 2, created_at: "2026-10-22T10:15:00Z",
+});
+
+async function setup(page: Page, options: { role?: string; penalties?: unknown[]; licences?: unknown[]; fail?: string[]; gate?: string[] } = {}) {
+  const calls: string[] = [];
+  const failures = new Set(options.fail ?? []);
+  let openGate = () => {};
+  const gate = new Promise<void>((resolve) => { openGate = resolve; });
+  const incidentId = "3e0c9f40-9f29-4f5d-aefa-a8d201aa7b11";
+  const data: Record<string, unknown> = {
+    "/api/auth/me": { id: "admin-1", email: "admin@apexgrid.test", full_name: "Race Admin", role: options.role ?? "ADMIN" },
+    "/api/dashboard": { counts: {}, latest_incidents: [] }, "/api/events": [], "/api/drivers": [], "/api/sessions": [],
+    "/api/incidents": [{ id: incidentId, reported_at: "2026-10-22T10:00:00Z", session_label: "Grand Prix · Race", driver_name: "Fixture Driver", lap: 18, description: "Review case with a long UUID and description that must remain attached to its source incident.", state: "OPEN" }],
+    "/api/stewarding/penalties": options.penalties ?? [], "/api/stewarding/licences": options.licences ?? [],
+  };
+  await page.route("**/api/**", async (route) => {
+    const request = route.request(); const url = new URL(request.url()); const path = url.pathname;
+    if (request.method() !== "GET") { calls.push(`write ${request.method()} ${path}`); await route.fulfill({ status: 405, json: { detail: "Unexpected write" } }); return; }
+    const source = path.endsWith("/stewarding/penalties") ? "penalties" : path.endsWith("/stewarding/licences") ? "licences" : "";
+    const key = source ? `/api/stewarding/${source}` : path;
+    calls.push(`${path}${url.search}`);
+    if (!(key in data)) { calls.push(`unexpected GET ${path}`); await route.fulfill({ status: 404, json: { detail: "Unexpected GET" } }); return; }
+    if (source && failures.has(source)) { if (options.gate?.includes(source)) await gate; await route.fulfill({ status: 503, json: { detail: "Source unavailable" } }); return; }
+    if (source && options.penalties && source === "penalties") {
+      const offset = Number(url.searchParams.get("offset") ?? 0);
+      await route.fulfill({ status: 200, json: options.penalties.slice(offset, offset + 50) }); return;
+    }
+    if (source && options.licences && source === "licences") {
+      const offset = Number(url.searchParams.get("offset") ?? 0);
+      await route.fulfill({ status: 200, json: options.licences.slice(offset, offset + 50) }); return;
+    }
+    await route.fulfill({ status: 200, json: data[key] });
+  });
+  return { calls, failures, data, openGate };
+}
+
+function expectClean(calls: string[]) {
+  expect(calls.filter((call) => call.startsWith("unexpected") || call.startsWith("write"))).toEqual([]);
+}
+
+test("official penalties and seasonal licence meters render accessibly", async ({ page }, testInfo) => {
+  const fixture = await setup(page, { penalties: [penalty("local-synthetic-penalty-9001", "local-synthetic-driver-1", "Alex Morgan")], licences: [driver("local-synthetic-driver-1", "Alex Morgan", 13), driver("local-synthetic-driver-2", "Sam Lee", 0)] });
+  await page.goto("/stewards");
+  const penalties = page.getByRole("region", { name: "Penalties and sanctions" });
+  const licences = page.getByRole("region", { name: "Licence points" });
+  await expect(penalties.getByRole("heading", { name: "Penalties and sanctions" })).toBeVisible();
+  const row = penalties.getByRole("row").filter({ hasText: "local-synthetic-penalty-9001" });
+  for (const value of ["Alex Morgan", "3", "18", "5", "2", "2026-10-22"]) await expect(row).toContainText(value);
+  const over = licences.getByRole("meter", { name: "Alex Morgan licence points" });
+  const zero = licences.getByRole("meter", { name: "Sam Lee licence points" });
+  await expect(over).toHaveAttribute("aria-valuenow", "12");
+  await expect(over).toHaveAttribute("aria-valuetext", `13 points in season ${season}`);
+  await expect(zero).toHaveAttribute("aria-valuenow", "0");
+  await expect(zero).toHaveAttribute("aria-valuetext", `0 points in season ${season}`);
+  for (const [region, name] of [[penalties, "penalties"], [licences, "licences"]] as const) {
+    await expect(region.getByRole("button", { name: `Next ${name} page` })).toBeVisible();
+    await expect(region.getByRole("button", { name: `Previous ${name} page` })).toBeVisible();
+  }
+  await expect(page.locator('[data-primary="true"]')).toHaveCount(1);
+  await penalties.screenshot({ path: testInfo.outputPath("steward-penalties.png") });
+  await licences.screenshot({ path: testInfo.outputPath("steward-licences.png") });
+  const axe = await new AxeBuilder({ page }).analyze();
+  expect(axe.violations).toEqual([]);
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBeTruthy();
+  expectClean(fixture.calls);
+});
+
+test("keyboard selection keeps the long case UUID and description in incident review", async ({ page }) => {
+  const fixture = await setup(page, { penalties: [], licences: [] }); await page.goto("/stewards");
+  await expect(page.getByRole("region", { name: "Penalties and sanctions" }).getByTestId("state-empty")).toBeVisible();
+  await expect(page.getByRole("region", { name: "Licence points" }).getByTestId("state-empty")).toBeVisible();
+  const row = page.getByRole("row").filter({ hasText: "Review case with a long UUID" });
+  await expect(row).toContainText("3e0c9f40-9f29-4f5d-aefa-a8d201aa7b11");
+  await row.focus(); await page.keyboard.press("Enter");
+  const dialog = page.getByRole("dialog", { name: "Incident review" });
+  await expect(dialog).toContainText("Review case with a long UUID and description that must remain attached to its source incident.");
+  expectClean(fixture.calls);
+});
+
+for (const source of ["penalties", "licences"] as const) test(`${source} outage preserves the other source and retained data`, async ({ page }) => {
+  const fixture = await setup(page, { role: "DRIVER", penalties: [penalty("local-synthetic-penalty-9001", "local-synthetic-driver-1", "Alex Morgan")], licences: [driver("local-synthetic-driver-1", "Alex Morgan", 8)], fail: [source], gate: [source] });
+  await page.goto("/stewards");
+  const penalties = page.getByRole("region", { name: "Penalties and sanctions" });
+  const licences = page.getByRole("region", { name: "Licence points" });
+  const failed = source === "penalties" ? penalties : licences;
+  const other = source === "penalties" ? licences : penalties;
+  await expect(failed.getByTestId("state-loading")).toBeVisible();
+  fixture.openGate();
+  await expect(failed.getByTestId("state-error")).toBeVisible();
+  await expect(page.getByText("Review case with a long UUID")).toBeVisible();
+  if (source === "licences") await expect(licences.getByRole("meter")).toHaveCount(0);
+  else await expect(licences.getByRole("meter", { name: "Alex Morgan licence points" })).toHaveAttribute("aria-valuetext", `8 points in season ${season}`);
+  if (source === "penalties") await expect(penalties.getByRole("meter")).toHaveCount(0);
+  else await expect(penalties.getByRole("row").filter({ hasText: "local-synthetic-penalty-9001" })).toBeVisible();
+  fixture.failures.delete(source); await failed.getByRole("button", { name: "Try again" }).click();
+  if (source === "penalties") await expect(penalties.getByRole("row").filter({ hasText: "local-synthetic-penalty-9001" })).toBeVisible();
+  else await expect(licences.getByRole("meter", { name: "Alex Morgan licence points" })).toHaveAttribute("aria-valuetext", `8 points in season ${season}`);
+  fixture.failures.add(source); await page.getByRole("button", { name: "Refresh" }).click();
+  await expect(failed.getByTestId("state-partial")).toBeVisible();
+  if (source === "penalties") await expect(penalties.getByRole("row").filter({ hasText: "local-synthetic-penalty-9001" })).toBeVisible();
+  else await expect(licences.getByRole("meter", { name: "Alex Morgan licence points" })).toHaveAttribute("aria-valuetext", `8 points in season ${season}`);
+  await expect(other).toBeVisible();
+  await expect(failed.getByRole("button", { name: new RegExp(`Retry ${source}`) })).toBeVisible();
+  expectClean(fixture.calls);
+});
+
+test("paging requests 50 then 1 row and previous restores offset zero", async ({ page }) => {
+  const rows = Array.from({ length: 51 }, (_, index) => penalty(`local-synthetic-penalty-${String(index + 1).padStart(3, "0")}`, `local-synthetic-driver-${index + 1}`, `Driver ${index + 1}`));
+  const fixture = await setup(page, { penalties: rows, licences: [] }); await page.goto("/stewards");
+  const region = page.getByRole("region", { name: "Penalties and sanctions" });
+  await expect(region.getByRole("row")).toHaveCount(51);
+  await region.getByRole("button", { name: /next.*penalt|penalt.*next/i }).click();
+  await expect(region.getByRole("row")).toHaveCount(2);
+  await expect(region.getByRole("row").filter({ hasText: "local-synthetic-penalty-051" })).toBeVisible();
+  expect(fixture.calls).toContain("/api/stewarding/penalties?limit=50&offset=50");
+  await region.getByRole("button", { name: /previous.*penalt|penalt.*previous/i }).click();
+  await expect(region.getByRole("row")).toHaveCount(51);
+  expect(fixture.calls).toContain("/api/stewarding/penalties?limit=50&offset=0");
+  expectClean(fixture.calls);
+});
