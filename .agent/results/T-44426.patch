@@ -0,0 +1,49 @@
+.nb-shell .resource-hero {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 24px;
+}
+.nb-shell .resource-hero .resource-hero-copy {
+  min-width: 0;
+}
+.nb-shell .resource-hero h1 {
+  margin: 8px 0;
+  font-size: var(--fs-h1);
+  font-weight: 700;
+}
+.nb-shell .resource-hero p {
+  max-width: 68ch;
+  margin: 0;
+  color: var(--color-muted);
+  line-height: 1.5;
+}
+.nb-shell .resource-hero .resource-count-sticker {
+  display: inline-flex;
+  min-height: 44px;
+  align-items: center;
+  margin-top: 16px;
+  border: 2px solid var(--color-ink);
+  background: var(--color-yellow);
+  padding: 8px 12px;
+  color: var(--color-ink);
+  font-weight: 700;
+  letter-spacing: 0.04em;
+}
+.nb-shell .resource-hero .header-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px;
+}
+@media (max-width: 619px) {
+  .nb-shell .resource-hero {
+    align-items: stretch;
+    flex-direction: column;
+  }
+  .nb-shell .resource-hero .header-actions {
+    align-items: stretch;
+    flex-direction: column;
+  }
+}
