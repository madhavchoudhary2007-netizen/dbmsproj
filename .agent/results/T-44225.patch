+import AxeBuilder from "@axe-core/playwright";
+import { expect, test } from "@playwright/test";
+let writes: string[] = [];
+let pageErrors: string[] = [];
+let consoleErrors: string[] = [];
+test.beforeEach(async ({ page }, testInfo) => {
+  writes = []; pageErrors = []; consoleErrors = [];
+  await page.emulateMedia({ reducedMotion: testInfo.title.startsWith("reduced motion") ? "reduce" : "no-preference" });
+  page.on("pageerror", (error) => pageErrors.push(error.message)); page.on("console", (message) => { if (message.type() === "error") consoleErrors.push(message.text()); });
+  await page.route("**/api/**", async (route) => {
+    const request = route.request();
+    if (request.method() !== "GET") {
+      writes.push(`${request.method()} ${new URL(request.url()).pathname}`);
+      await route.abort();
+      return;
+    }
+    const pathname = new URL(request.url()).pathname;
+    const body = pathname === "/api/auth/me"
+      ? { id: "fixture-admin", email: "fixture@example.test", full_name: "Fixture Admin", role: "ADMIN" }
+      : [];
+    await route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(body) });
+  });
+  await page.goto("/__nb", { waitUntil: "domcontentloaded" });
+  await expect(page.getByTestId("nb-guide")).toBeVisible();
+});
+test.afterEach(() => expect(writes).toEqual([]));
+test("guide has one accessible page structure and no browser errors", async ({ page }) => {
+  const motion = await page.evaluate(async () => {
+    await document.fonts.ready; const animations = document.getAnimations();
+    const timings = animations.map((animation) => { const timing = animation.effect?.getComputedTiming(); return { duration: Number(timing?.duration), iterations: Number(timing?.iterations) }; });
+    await Promise.all(animations.filter((_, i) => timings[i].duration <= 300 && Number.isFinite(timings[i].iterations)).map((animation) => animation.finished.catch(() => undefined))); return timings;
+  });
+  expect(motion.every(({ duration }) => duration <= 300)).toBe(true); expect(motion.every(({ iterations }) => Number.isFinite(iterations))).toBe(true);
+  const result = await new AxeBuilder({ page }).withTags(["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"]).analyze();
+  expect(await page.locator("main").count()).toBe(1); expect(await page.locator("h1").count()).toBe(1);
+  expect(result.violations).toEqual([]); expect(pageErrors).toEqual([]); expect(consoleErrors).toEqual([]);
+});
+test("controls are keyboard visible, touch sized, and use only approved corners", async ({ page }) => {
+  const guide = page.getByTestId("nb-guide"); const controls = guide.locator("a[href]:visible, button:not([disabled]):visible, input:not([disabled]):not([type=hidden]):visible, select:not([disabled]):visible, textarea:not([disabled]):visible, [role=button]:not([aria-disabled=true]):visible, [role=link]:not([aria-disabled=true]):visible, tr[tabindex='0']:visible");
+  for (let i = 0; i < await controls.count(); i++) {
+    const control = controls.nth(i);
+    const size = await control.evaluate((element) => { const r = element.getBoundingClientRect(); return { dimensions: [r.width, r.height], detail: `${element.outerHTML.slice(0, 200)} text=${element.textContent?.trim() ?? ""}` }; });
+    expect(size.dimensions[0], size.detail).toBeGreaterThanOrEqual(44); expect(size.dimensions[1], size.detail).toBeGreaterThanOrEqual(44);
+    await page.keyboard.press("Tab");
+    await control.focus();
+    const focus = await control.evaluate((element) => { const style = getComputedStyle(element); return { visible: element.matches(":focus-visible"), width: parseFloat(style.outlineWidth), style: style.outlineStyle, color: style.outlineColor }; });
+    expect(focus.visible).toBe(true); expect(focus.width).toBeGreaterThan(0);
+    expect(focus.style).not.toBe("none");
+    expect(focus.color).not.toBe("transparent");
+  }
+  expect(await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)).toBeLessThanOrEqual(0);
+  expect(await guide.locator("*").evaluateAll((elements) => elements
+    .map((element) => ({ radius: getComputedStyle(element).borderRadius, classes: element.getAttribute("class") ?? "" }))
+    .filter(({ radius, classes }) => radius !== "0px" && !/(^|\s)rounded-full(?:\s|$)/.test(classes)))).toEqual([]);
+  expect(await guide.locator("[class*='rounded-'], [class~='rounded']").evaluateAll((elements) => elements
+    .flatMap((element) => (element.getAttribute("class") ?? "").split(/\s+/).filter((name) => name === "rounded" || (name.startsWith("rounded-") && name !== "rounded-none" && name !== "rounded-full"))))).toEqual([]);
+});
+test("primary plinth presses its face onto the unchanged four pixel shadow", async ({ page }) => {
+  const primary = page.getByTestId("nb-guide").locator("[data-primary='true']").first();
+  const before = await primary.evaluate((element) => ({ transform: getComputedStyle(element, "::before").transform, transition: getComputedStyle(element, "::before").transitionDuration }));
+  const box = await primary.boundingBox();
+  expect(box).not.toBeNull();
+  await page.mouse.move(box!.x + box!.width / 2, box!.y + box!.height / 2);
+  await page.mouse.down();
+  await expect.poll(() => primary.evaluate((element) => { const matrix = new DOMMatrix(getComputedStyle(element.querySelector(".nb-face")!).transform); return [matrix.e, matrix.f]; })).toEqual([4, 4]);
+  const pressed = await primary.evaluate((element) => {
+    return { before: getComputedStyle(element, "::before").transform, transition: getComputedStyle(element, "::before").transitionDuration };
+  });
+  await page.mouse.up();
+  expect(pressed.before).toBe(before.transform);
+  expect(before.transition).toBe("0s"); expect(pressed.transition).toBe("0s");
+});
+test("reduced motion leaves the static marquee with one visible copy per item", async ({ page }) => {
+  await page.emulateMedia({ reducedMotion: "reduce" });
+  await page.reload({ waitUntil: "domcontentloaded" }); await expect(page.getByTestId("nb-guide")).toBeVisible();
+  expect(await page.evaluate(() => document.getAnimations().length)).toBe(0);
+  const marquees = page.locator(".nb-marquee");
+  expect(await page.locator("[aria-live='off']").count()).toBeGreaterThanOrEqual(3);
+  for (let i = 0; i < await marquees.count(); i++) {
+    const items = i === 0 ? ["red feed one", "red feed two"] : i === 1 ? ["yellow feed one", "yellow feed two"] : ["paper feed one", "paper feed two"];
+    for (const item of items) {
+      const copies = await marquees.nth(i).evaluate((root, label) => Array.from(root.querySelectorAll("*"))
+        .filter((element) => element.textContent?.trim() === label)
+        .map((element) => ({ visible: Boolean((element as HTMLElement).offsetWidth || (element as HTMLElement).offsetHeight), hidden: element.getAttribute("aria-hidden") === "true" })), item);
+      const exposed = copies.filter((copy) => !copy.hidden);
+      expect(exposed).toHaveLength(1); expect(exposed[0].visible).toBe(true);
+    }
+  }
+});
+test("each primitive renders all five states and actions fire once", async ({ page }) => {
+  for (const status of ["loading", "empty", "populated", "error", "partial"]) {
+    const scope = page.locator(`[data-nb-state='${status}']`);
+    const table = page.locator(`[data-nb-table='${status}']`); const chart = page.locator(`[data-nb-chart='${status}']`);
+    for (const wrapper of [scope, table, chart]) {
+      await expect(wrapper).toBeVisible();
+      if (status === "loading") await expect(wrapper.locator("[aria-busy='true']")).toBeVisible();
+      if (status === "empty") await expect(wrapper.getByRole("status")).toContainText("No fixture records.");
+      if (status === "error") { await expect(wrapper.getByRole("alert")).toContainText("Fixture request unavailable"); await expect(wrapper.getByRole("button", { name: "Try again" })).toBeVisible(); }
+      if (status === "partial") { await expect(wrapper).toContainText("Mongo fixture unavailable"); await expect(wrapper.getByRole("button", { name: /Clear filter/ })).toBeVisible(); }
+    }
+    if (status === "populated") { await expect(scope).toContainText("Nova Vale"); await expect(table).toContainText("Nova Vale"); await expect(chart.locator("[role=img] svg polyline")).toHaveCount(2); }
+  }
+  const value = page.getByTestId("demo-value");
+  await page.getByRole("button", { name: "Update example" }).click();
+  await expect(value).toHaveText("Value 1");
+  await page.locator("[data-nb-state='error']").getByRole("button", { name: "Try again" }).click();
+  await expect(value).toHaveText("Value 2");
+  await page.locator("[data-nb-state='partial']").getByRole("button", { name: /Clear filter/ }).click();
+  await expect(value).toHaveText("Value 3");
+  const row = page.locator("[data-nb-table='populated'] tbody tr[tabindex='0']").first();
+  await row.press("Enter");
+  await expect(value).toHaveText("Value 4");
+  await row.press("Space");
+  await expect(value).toHaveText("Value 5");
+});
+test("tabs skip disabled items and the native modal traps and restores focus", async ({ page }) => {
+  const overview = page.getByRole("tab", { name: "Overview" });
+  const timing = page.getByRole("tab", { name: "Timing" });
+  const disabled = page.getByRole("tab", { name: "Disabled" });
+  await overview.focus();
+  await overview.press("ArrowRight");
+  await expect(timing).toBeFocused();
+  await expect(timing).toHaveAttribute("aria-selected", "true");
+  await expect(timing).toHaveAttribute("tabindex", "0");
+  await expect(overview).toHaveAttribute("tabindex", "-1");
+  await expect(page.locator("#guide-panel-timing")).toBeVisible(); await expect(page.locator("#guide-panel-overview")).toBeHidden();
+  await timing.press("ArrowRight");
+  await expect(overview).toBeFocused(); await expect(page.locator("#guide-panel-timing")).toBeHidden();
+  await expect(disabled).toBeDisabled();
+  await timing.press("End");
+  await expect(timing).toBeFocused();
+  await timing.press("Home");
+  await expect(overview).toBeFocused();
+  const open = page.getByRole("button", { name: "Open modal" });
+  await open.click();
+  const dialog = page.locator("dialog");
+  await expect.poll(() => dialog.evaluate((element) => element.matches(":modal"))).toBe(true);
+  await page.keyboard.press("Tab");
+  expect(await dialog.locator(":focus").count()).toBe(1);
+  await page.keyboard.press("Shift+Tab");
+  expect(await dialog.locator(":focus").count()).toBe(1);
+  await page.keyboard.press("Escape");
+  await expect(open).toBeFocused();
+  await expect(page.getByTestId("demo-value")).toHaveText("Value 1");
+  await open.click();
+  await dialog.getByRole("button", { name: "Close" }).click();
+  await expect(open).toBeFocused();
+  await expect(page.getByTestId("demo-value")).toHaveText("Value 2");
+});
