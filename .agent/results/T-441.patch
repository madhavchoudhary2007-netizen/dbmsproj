diff --git a/frontend/e2e/palette-contrast.spec.ts b/frontend/e2e/palette-contrast.spec.ts
new file mode 100644
index 0000000..bed31a7
--- /dev/null
+++ b/frontend/e2e/palette-contrast.spec.ts
@@ -0,0 +1,33 @@
+import { expect, test } from "@playwright/test";
+import { measurePalette } from "./palette-measure";
+
+test("black text on black heading is measured and fails AA", async ({ page }) => {
+  await page.setContent('<div style="background: black"><h1 style="color: black">Hidden</h1></div>');
+  const result = await page.evaluate(measurePalette);
+
+  expect(result.headingContrasts).toEqual([1]);
+  expect(() => expect(result.headingContrasts[0]).toBeGreaterThanOrEqual(4.5)).toThrow();
+});
+
+test("contrasting real heading passes and aria-hidden duplicate is excluded", async ({ page }) => {
+  await page.setContent(
+    '<div style="background: black"><h1 style="color: white">Visible</h1>' +
+      '<section aria-hidden="true"><h2 style="color: black">Decoration</h2></section></div>',
+  );
+  const result = await page.evaluate(measurePalette);
+
+  expect(result.headingContrasts).toHaveLength(1);
+  expect(result.headingContrasts[0]).toBeGreaterThanOrEqual(4.5);
+});
+
+test("transparent nested backgrounds resolve to the nearest opaque ancestor", async ({ page }) => {
+  await page.setContent(
+    '<div style="background: blue"><section style="background: transparent">' +
+      '<h3 style="color: white">Visible</h3></section></div>',
+  );
+  const result = await page.evaluate(measurePalette);
+
+  expect(result.headingContrasts).toHaveLength(1);
+  expect(result.headingContrasts[0]).toBeCloseTo(8.59, 2);
+  expect(result.headingContrasts[0]).toBeGreaterThanOrEqual(4.5);
+});
diff --git a/frontend/e2e/palette-measure.ts b/frontend/e2e/palette-measure.ts
new file mode 100644
index 0000000..682bb0a
--- /dev/null
+++ b/frontend/e2e/palette-measure.ts
@@ -0,0 +1,48 @@
+export function measurePalette(): { bgLum: number; headingContrasts: number[] } {
+  function parseRgb(color: string): [number, number, number] {
+    const values = color.match(/[\d.]+/g);
+    return values && values.length >= 3
+      ? [Number(values[0]), Number(values[1]), Number(values[2])]
+      : [0, 0, 0];
+  }
+
+  function luminance(rgb: [number, number, number]): number {
+    const [r, g, b] = rgb.map((channel) => {
+      const value = channel / 255;
+      return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
+    });
+    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+  }
+
+  function contrast(first: number, second: number): number {
+    const lighter = Math.max(first, second);
+    const darker = Math.min(first, second);
+    return (lighter + 0.05) / (darker + 0.05);
+  }
+
+  function opaqueBackground(element: Element): string {
+    let current: Element | null = element;
+    while (current) {
+      const background = window.getComputedStyle(current).backgroundColor;
+      const alpha =
+        background.match(/rgba\([^,]+,[^,]+,[^,]+,\s*([\d.]+)\s*\)$/)?.[1] ??
+        background.match(/rgb\([^)]*\/\s*([\d.]+)\s*\)$/)?.[1];
+      if (!background.includes("transparent") && (alpha === undefined || Number(alpha) === 1)) {
+        return background;
+      }
+      current = current.parentElement;
+    }
+    return "rgb(255, 255, 255)";
+  }
+
+  const bgLum = luminance(parseRgb(opaqueBackground(document.body)));
+  const headingContrasts = Array.from(document.querySelectorAll("h1, h2, h3"))
+    .filter((heading) => !heading.closest('[aria-hidden="true"]'))
+    .map((heading) => {
+      const foreground = parseRgb(window.getComputedStyle(heading).color);
+      const background = parseRgb(opaqueBackground(heading));
+      return contrast(luminance(foreground), luminance(background));
+    });
+
+  return { bgLum, headingContrasts };
+}
