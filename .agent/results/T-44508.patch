+.nb-shell .telemetry-charts .chart {
+  height: auto;
+  min-width: 0;
+  margin: 0;
+}
+.nb-shell .snapshot-strip {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
+  gap: 8px;
+  min-width: 0;
+  margin: 12px 0;
+  padding: 12px;
+  border: 4px solid var(--nb-ink);
+  background: var(--nb-paper);
+  color: var(--nb-ink);
+}
+.nb-shell .snapshot-strip > div {
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.nb-shell .snapshot-strip small,
+.nb-shell .snapshot-strip b {
+  display: block;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.nb-shell .snapshot-strip small {
+  font-size: var(--fs-label);
+}
+.nb-shell .snapshot-strip b {
+  font-family: var(--font-mono);
+  font-size: var(--fs-body);
+}
+.nb-shell .safety-car-banner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  min-height: 44px;
+  overflow-wrap: anywhere;
+  padding: 12px 16px;
+  border: 4px solid var(--nb-ink);
+  background: var(--nb-yellow);
+  color: var(--nb-ink);
+  font-size: var(--fs-body);
+  line-height: 1.5;
+  letter-spacing: normal;
+}
