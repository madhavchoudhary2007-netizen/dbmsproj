diff --git a/scripts/eval/rules/gray.good.css b/scripts/eval/rules/gray.good.css
new file mode 100644
index 0000000..b6e8a17
--- /dev/null
+++ b/scripts/eval/rules/gray.good.css
@@ -0,0 +1,8 @@
+/* gray-family values in comments are ignored: .x { color: #888; } */
+.good {
+  color: #000;
+  background: #FFFDF5;
+  border-color: #FF6B6B;
+  background-image: url(#888);
+  content: "#888";
+}
