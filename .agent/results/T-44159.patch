diff --git a/scripts/eval/neo_colour.py b/scripts/eval/neo_colour.py
new file mode 100644
index 0000000..96a3346
--- /dev/null
+++ b/scripts/eval/neo_colour.py
@@ -0,0 +1,128 @@
+"""Gray-family colour checks shared by the Neo-Brutal evaluation linter."""
+
+import re
+import sys
+from pathlib import Path
+
+from scripts.eval.source_text import mask_comments
+
+FAMILIES = "gray|slate|zinc|neutral|stone"
+CATEGORIES = (
+    "bg|text|border|ring|outline|fill|stroke|from|via|to|shadow|divide|"
+    "decoration|placeholder|accent|caret"
+)
+UTILITY = re.compile(
+    rf"(?<![\w-])(?:[\w-]+:)*(?:{CATEGORIES})-(?:{FAMILIES})"
+    r"(?:-[\w./%]+|\[[^\]\s]*\])?(?![\w-])"
+)
+HEX = re.compile(r"#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})(?![\w])")
+APPROVED = {"fffdf5", "ffffff", "000000", "ff6b6b", "ffd93d", "c4b5fd", "7cf5b0", "7cc4ff"}
+
+
+def _neutral(value: str) -> bool:
+    digits = value[1:].lower()
+    if len(digits) in (3, 4):
+        digits = "".join(char * 2 for char in digits)
+    rgb = digits[:6]
+    return rgb[0:2] == rgb[2:4] == rgb[4:6] and rgb not in ("000000", "ffffff")
+
+
+def _in_string(text: str, offset: int) -> bool:
+    quote = ""
+    escaped = False
+    for char in text[:offset]:
+        if escaped:
+            escaped = False
+        elif quote and char == "\\":
+            escaped = True
+        elif quote and char == quote:
+            quote = ""
+        elif not quote and char in "\"'`":
+            quote = char
+    return bool(quote)
+
+
+def _css_value(text: str, offset: int) -> bool:
+    start = max(text.rfind("{", 0, offset), text.rfind(";", 0, offset)) + 1
+    prefix = text[start:offset]
+    if ":" not in prefix or re.search(r"url\s*\([^)]*$", prefix, re.I):
+        return False
+    return not _in_string(text, offset)
+
+
+def check_gray(text: str, css: bool = False) -> list[tuple[int, str]]:
+    """Return source offsets and rules for forbidden gray-family colours."""
+    clean = mask_comments(text, css=css)
+    hits = [(m.start(), "gray-family utility") for m in UTILITY.finditer(clean)]
+    for match in HEX.finditer(clean):
+        value = match.group()
+        arbitrary = "[" in clean[max(0, match.start() - 32) : match.start()]
+        if value[1:].lower() in APPROVED or not _neutral(value):
+            continue
+        if arbitrary or (css and _css_value(clean, match.start())):
+            hits.append((match.start(), "neutral hex colour"))
+    return sorted(set(hits))
+
+
+def _self_test() -> int:
+    def require(condition: bool, message: str) -> None:
+        if not condition:
+            raise AssertionError(message)
+
+    rules = Path(__file__).with_name("rules")
+    good = (rules / "gray.good.css").read_text()
+    bad = (rules / "gray.bad.css").read_text()
+    require(not check_gray(good, css=True), "good fixture should pass")
+    require(bool(check_gray(bad, css=True)), "bad fixture should fail")
+
+    cases = [
+        ("bg-gray-500", False),
+        ("dark:text-slate-200", False),
+        ("border-zinc-300", False),
+        ("ring-neutral-700", False),
+        ("outline-stone-400", False),
+        ("fill-gray-600", False),
+        ("stroke-slate-500", False),
+        ("from-zinc-100", False),
+        ("via-neutral-300", False),
+        ("to-stone-800", False),
+        ("shadow-gray-900", False),
+        ("divide-slate-200", False),
+        ("decoration-zinc-400", False),
+        ("placeholder-neutral-500", False),
+        ("accent-stone-300", False),
+        ("caret-gray-700", False),
+        ("bg-[#888]", False),
+        ("text-[#8888]", False),
+        ("border-[#888888]", False),
+        ("ring-[#88888888]", False),
+        (".x{color:#888}", True),
+        (".x{color:#8888}", True),
+        (".x{color:#888888}", True),
+        (".x{color:#88888888}", True),
+    ]
+    for sample, is_css in cases:
+        require(bool(check_gray(sample, css=is_css)), f"expected gray violation: {sample}")
+
+    clean = (
+        "/* bg-gray-500 #888 */\n.x{color:#000;background:#fff;color:#FFFDF5; "
+        "background:#FF6B6B; background:url(#888)}"
+    )
+    require(not check_gray(clean, css=True), "comments, palette and URL fragments pass")
+    control = "identifier-gray-500 #888 .x{content:'#888';color:#123456}"
+    require(not check_gray(control, css=True), "identifiers, strings and chromatic hex pass")
+    offset_sample = "/* #888 */\n.x { color: #888; }"
+    expected = offset_sample.index("#888", offset_sample.index("*/"))
+    require(
+        check_gray(offset_sample, css=True) == [(expected, "neutral hex colour")],
+        "offset preserved",
+    )
+    print(f"self-test assertions passed: {len(cases) + 5}")
+    return len(cases) + 5
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
+        _self_test()
+    else:
+        raise SystemExit("usage: python scripts/eval/neo_colour.py --self-test")
