diff --git a/frontend/e2e/runtime/field-validation.test.mjs b/frontend/e2e/runtime/field-validation.test.mjs
new file mode 100644
index 0000000..e52ec2a
--- /dev/null
+++ b/frontend/e2e/runtime/field-validation.test.mjs
@@ -0,0 +1,116 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import * as vm from "node:vm";
+
+const require = createRequire(import.meta.url);
+const typescript = require("../../node_modules/typescript");
+const source = readFileSync(new URL("../../lib/use-field-validation.ts", import.meta.url), "utf8");
+
+async function load() {
+  const realm = vm.createContext({});
+  const output = typescript.transpileModule(source, {
+    compilerOptions: { module: typescript.ModuleKind.ESNext, target: typescript.ScriptTarget.ES2022 },
+  }).outputText;
+  let state;
+  const pending = [];
+  const react = new vm.SyntheticModule(["useState"], function () {
+    this.setExport("useState", initial => {
+      if (state === undefined) state = initial;
+      return [state, update => pending.push(update)];
+    });
+  }, { context: realm, identifier: "react" });
+  const hookModule = new vm.SourceTextModule(output, { context: realm, identifier: "./use-field-validation.ts" });
+  await hookModule.link(specifier => {
+    if (specifier === "react") return react;
+    throw new Error(`Unexpected import: ${specifier}`);
+  });
+  await hookModule.evaluate();
+  const render = () => hookModule.namespace.useFieldValidation();
+  const flush = () => {
+    for (const update of pending.splice(0)) state = typeof update === "function" ? update(state) : update;
+  };
+  return { render, flush, get state() { return state; } };
+}
+
+const field = (valid, message = "") => ({ validity: { valid }, validationMessage: message });
+const assertErrors = (actual, expected) => assert.deepEqual({ ...actual }, expected);
+
+test("revalidate leaves an untouched invalid field without an error", async () => {
+  const hook = await load();
+  hook.render();
+  const initial = hook.state;
+  hook.render().revalidate("email", field(false, "Enter a valid email address."));
+  hook.flush();
+  assert.equal(hook.state, initial);
+  assertErrors(hook.state, {});
+});
+
+test("validate records native messages and clears them for valid fields", async () => {
+  const hook = await load();
+  hook.render().validate("email", field(false, "Please fill out this field."));
+  hook.flush();
+  assertErrors(hook.state, { email: "Please fill out this field." });
+  hook.render().validate("email", field(true));
+  hook.flush();
+  assertErrors(hook.state, {});
+});
+
+test("revalidate updates a message and clears it when the field becomes valid", async () => {
+  const hook = await load();
+  hook.render().validate("email", field(false, "First native message."));
+  hook.flush();
+  hook.render().revalidate("email", field(false, "Updated native message."));
+  hook.flush();
+  assertErrors(hook.state, { email: "Updated native message." });
+  hook.render().revalidate("email", field(true));
+  hook.flush();
+  assertErrors(hook.state, {});
+});
+
+test("queued validations compose and preserve unrelated errors", async () => {
+  const hook = await load();
+  hook.render().validate("password", field(false, "Password required."));
+  hook.flush();
+  const actions = hook.render();
+  actions.validate("email", field(false, "Email required."));
+  actions.validate("name", field(false, "Name required."));
+  hook.flush();
+  assertErrors(hook.state, {
+    password: "Password required.", email: "Email required.", name: "Name required.",
+  });
+});
+
+test("queued invalid then valid updates clear the error", async () => {
+  const hook = await load();
+  const actions = hook.render();
+  const changing = field(false, "Call-time native message.");
+  actions.validate("email", changing);
+  changing.validity.valid = true;
+  changing.validationMessage = "Later mutated message.";
+  actions.validate("email", changing);
+  hook.flush();
+  assertErrors(hook.state, {});
+});
+
+test("validation snapshots the native message before queued state flush", async () => {
+  const hook = await load();
+  const actions = hook.render();
+  const changing = field(false, "Call-time native message.");
+  actions.validate("email", changing);
+  changing.validity.valid = true;
+  changing.validationMessage = "Later mutated message.";
+  hook.flush();
+  assertErrors(hook.state, { email: "Call-time native message." });
+});
+
+test("same-message validation retains the existing errors object", async () => {
+  const hook = await load();
+  hook.render().validate("email", field(false, "Email required."));
+  hook.flush();
+  const prior = hook.state;
+  hook.render().validate("email", field(false, "Email required."));
+  hook.flush();
+  assert.equal(hook.state, prior);
+});
