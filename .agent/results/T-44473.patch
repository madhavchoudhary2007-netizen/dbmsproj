+test("empty membership history explains that no history was returned", async ({ page }) => {
+  await page.route("**/api/teams/team-a/memberships", async (route) => {
+    sharedMembershipReads++;
+    await route.fulfill({ status: 200, json: [] });
+  });
+  const dialog = await openTeam(page);
+  await expect(dialog.getByTestId("state-empty")).toBeVisible();
+  await expect(dialog.getByText("No membership history returned.")).toBeVisible();
+  expect(writes).toEqual([]);
+});
+
+test("partial membership refresh retains rows and recovers on retry", async ({ page }) => {
+  let reads = 0;
+  await page.route("**/api/teams/team-a/memberships", async (route) => {
+    reads++;
+    sharedMembershipReads++;
+    await route.fulfill(reads === 2
+      ? { status: 503, json: { detail: "Roster refresh unavailable" } }
+      : { status: 200, json: memberships });
+  });
+  await page.route("**/api/team-memberships/open", async (route) => {
+    if (route.request().method() === "PATCH") {
+      permittedMembershipWrites.push(`${route.request().method()} ${new URL(route.request().url()).pathname}`);
+      await route.fulfill({ status: 200, json: { ...memberships[0], end_date: "2026-10-25" } });
+      return;
+    }
+    await route.fallback();
+  });
+  const dialog = await openTeam(page);
+  await expect(dialog.getByText("Open Driver")).toBeVisible();
+  await dialog.getByRole("button", { name: "End membership", exact: true }).click();
+  const partial = dialog.getByTestId("state-partial");
+  await expect(partial).toBeVisible();
+  await expect(partial.getByText("Open Driver")).toBeVisible();
+  await expect(partial.getByRole("alert")).toContainText("Roster refresh unavailable");
+  await partial.getByRole("button", { name: "Try again", exact: true }).click();
+  await expect(dialog.getByTestId("state-populated")).toBeVisible();
+  await expect(dialog.getByText("Open Driver")).toBeVisible();
+  expect(reads).toBe(3);
+  expect(permittedMembershipWrites).toEqual(["PATCH /api/team-memberships/open"]);
+  expect(writes).toEqual([]);
+});
