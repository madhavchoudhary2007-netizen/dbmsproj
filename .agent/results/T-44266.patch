+++ b/frontend/app/styles/login.css
@@ -0,0 +1,40 @@
+/* Dormant until the login route opts into .nb-login. */
+.nb-login.login-screen { min-width: 0; overflow: hidden; grid-template-columns: 60% 40%; gap: 0; background: var(--nb-cream, #FFFDF5); }
+.nb-login .login-visual, .nb-login .login-main { min-width: 0; border: 4px solid var(--nb-ink, #000000); }
+.nb-login .login-visual { position: relative; isolation: isolate; overflow: hidden; padding: 32px; background: var(--nb-cream, #FFFDF5); border-inline-end: 0; }
+.nb-login .nb-login-art-texture { position: absolute; inset: 0; z-index: -1; opacity: 0.1; pointer-events: none; }
+.nb-login .login-brand, .nb-login .visual-copy, .nb-login .visual-footer, .nb-login .nb-login-art-body { position: relative; z-index: 1; }
+.nb-login .nb-login-art-body { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: center; gap: 24px; }
+.nb-login .nb-login-display-stack { position: relative; display: inline-block; width: fit-content; max-width: 100%; }
+.nb-login .nb-login-display { display: block; color: var(--nb-ink, #000000); font-family: var(--font-space-grotesk), ui-sans-serif, system-ui, sans-serif; font-size: clamp(3rem, 1.2rem + 6vw, 7rem); font-weight: 700; line-height: 1; letter-spacing: -0.08em; overflow-wrap: anywhere; }
+.nb-login .nb-login-display-stroke { position: absolute; inset: 0; z-index: -1; color: transparent; -webkit-text-stroke: 2px var(--nb-ink, #000000); transform: translate(8px, 8px); }
+.nb-login .visual-copy { max-width: 36rem; }
+.nb-login .visual-copy .eyebrow { display: flex; align-items: center; gap: 8px; color: var(--nb-ink, #000000); font-family: var(--font-space-grotesk), ui-sans-serif, system-ui, sans-serif; font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem); font-weight: 700; letter-spacing: 0.08em; }
+.nb-login .nb-login-hero-copy { margin: 16px 0; color: var(--nb-ink, #000000); font-family: var(--font-space-grotesk), ui-sans-serif, system-ui, sans-serif; font-size: clamp(2rem, 1.2rem + 3vw, 4rem); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
+.nb-login .nb-login-hero-copy span { color: var(--nb-red, #FF6B6B); }
+.nb-login .visual-copy > p:last-child { max-width: 36ch; color: var(--nb-ink, #000000); font-family: var(--font-space-mono), ui-monospace, monospace; font-size: 0.875rem; line-height: 1.5; }
+.nb-login .nb-login-art-row { display: flex; min-width: 0; align-items: center; gap: 16px; }
+.nb-login .nb-login-sticker { display: inline-flex; flex-shrink: 0; align-items: center; gap: 8px; min-height: 44px; }
+.nb-login .nb-login-sticker-icon { width: 24px; height: 24px; }
+.nb-login .nb-login-marquee { min-width: 0; flex: 1; }
+.nb-login .visual-footer { display: flex; justify-content: space-between; gap: 16px; color: var(--nb-ink, #000000); font-family: var(--font-space-mono), ui-monospace, monospace; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; }
+.nb-login .nb-login-checker { position: relative; z-index: 1; width: 100%; height: 16px; flex-shrink: 0; }
+.nb-login .login-main { position: relative; z-index: 0; min-height: 0; margin: 32px; justify-content: center; padding: 32px; background: var(--nb-paper, #FFFFFF); }
+.nb-login .login-main::after { content: ""; position: absolute; inset: 12px -12px -12px 12px; z-index: -1; border: 4px solid var(--nb-ink, #000000); background: var(--nb-ink, #000000); pointer-events: none; }
+.nb-login .login-form { width: min(100%, 32rem); min-width: 0; }
+.nb-login .login-form input, .nb-login .login-submit { min-height: 48px; }
+.nb-login .login-form input { width: 100%; min-width: 0; }
+@media (max-width: 999px) {
+  .nb-login.login-screen { grid-template-columns: 1fr; }
+  .nb-login .login-visual { min-height: 240px; padding: 24px; border-inline-end: 4px solid var(--nb-ink, #000000); border-block-end: 0; }
+  .nb-login .nb-login-art-body { gap: 16px; }
+  .nb-login .nb-login-display { font-size: clamp(3rem, 14vw, 5rem); }
+  .nb-login .visual-copy { display: none; }
+  .nb-login .login-main { min-height: 0; margin: 24px; padding: 32px 24px; }
+  .nb-login .login-main::after { inset: 8px -8px -8px 8px; }
+}
+@media (max-width: 511px) {
+  .nb-login .nb-login-art-row { align-items: stretch; flex-direction: column; }
+  .nb-login .nb-login-marquee { width: 100%; }
+  .nb-login .visual-footer { font-size: 0.6875rem; }
+}
