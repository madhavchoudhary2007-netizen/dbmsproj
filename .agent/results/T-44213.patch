new file mode 100644
index 0000000..4e80c8c
--- /dev/null
+++ b/frontend/lib/use-delayed-flag.ts
@@ -0,0 +1,41 @@
+"use client";
+
+import { useMemo, useSyncExternalStore } from "react";
+
+type DelayedFlagStore = {
+  getSnapshot: () => boolean;
+  getServerSnapshot: () => boolean;
+  subscribe: (listener: () => void) => () => void;
+};
+
+function createDelayedFlagStore(active: boolean, delay: number): DelayedFlagStore {
+  let visible = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const listeners = new Set<() => void>();
+  return {
+    getSnapshot: () => visible,
+    getServerSnapshot: () => false,
+    subscribe: (listener) => {
+      listeners.add(listener);
+      if (active && !visible && timer === undefined && typeof window !== "undefined") {
+        timer = setTimeout(() => {
+          timer = undefined;
+          visible = true;
+          listeners.forEach((current) => current());
+        }, Math.max(0, delay));
+      }
+      return () => {
+        listeners.delete(listener);
+        if (listeners.size === 0 && timer !== undefined) {
+          clearTimeout(timer);
+          timer = undefined;
+        }
+      };
+    },
+  };
+}
+
+export function useDelayedFlag(active: boolean, delay = 150): boolean {
+  const store = useMemo(() => createDelayedFlagStore(active, delay), [active, delay]);
+  return useSyncExternalStore(store.subscribe, store.getSnapshot, store.getServerSnapshot);
+}
diff --git a/frontend/lib/use-native-dialog.ts b/frontend/lib/use-native-dialog.ts
new file mode 100644
index 0000000..a3887f5
--- /dev/null
+++ b/frontend/lib/use-native-dialog.ts
@@ -0,0 +1,67 @@
+"use client";
+
+import { useEffect, useRef, type RefObject } from "react";
+
+export function useNativeDialog(
+  dialogRef: RefObject<HTMLDialogElement | null>,
+  open: boolean,
+  onClose: () => void,
+): void {
+  const onCloseRef = useRef(onClose);
+  const previousFocusRef = useRef<HTMLElement | null>(null);
+  const suppressCloseRef = useRef(false);
+  const didNotifyCloseRef = useRef(false);
+  useEffect(() => { onCloseRef.current = onClose; }, [onClose]);
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    const restoreFocus = () => {
+      const previousFocus = previousFocusRef.current;
+      previousFocusRef.current = null;
+      if (previousFocus?.isConnected) previousFocus.focus();
+    };
+    const handleClose = () => {
+      if (dialog.open) return;
+      const suppressed = suppressCloseRef.current;
+      suppressCloseRef.current = false;
+      restoreFocus();
+      if (suppressed || didNotifyCloseRef.current) return;
+      didNotifyCloseRef.current = true;
+      onCloseRef.current();
+    };
+    const handleClick = (event: MouseEvent) => {
+      if (event.target !== dialog || !dialog.open) return;
+      const rect = dialog.getBoundingClientRect();
+      const outside = event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
+      if (outside) dialog.close();
+    };
+    dialog.addEventListener("close", handleClose);
+    dialog.addEventListener("click", handleClick);
+    return () => {
+      if (dialog.open) {
+        suppressCloseRef.current = true;
+        dialog.close();
+      }
+      dialog.removeEventListener("close", handleClose);
+      dialog.removeEventListener("click", handleClick);
+      restoreFocus();
+    };
+  }, [dialogRef]);
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open) {
+      didNotifyCloseRef.current = false;
+      suppressCloseRef.current = false;
+      if (!dialog.open) {
+        previousFocusRef.current = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+        dialog.showModal();
+      }
+      return;
+    }
+    if (dialog.open) {
+      suppressCloseRef.current = true;
+      dialog.close();
+    }
+  }, [dialogRef, open]);
+}
diff --git a/frontend/lib/use-nb-demo.ts b/frontend/lib/use-nb-demo.ts
new file mode 100644
index 0000000..4e64253
--- /dev/null
+++ b/frontend/lib/use-nb-demo.ts
@@ -0,0 +1,42 @@
+"use client";
+
+import { useCallback, useMemo, useState, type Dispatch, type SetStateAction } from "react";
+
+export type NbDemoRow = Readonly<{ id: string; label: string }>;
+const SMALL_ROWS: readonly NbDemoRow[] = [
+  { id: "row-1", label: "First row" },
+  { id: "row-2", label: "Second row" },
+  { id: "row-3", label: "Third row" },
+];
+const LARGE_ROWS: readonly NbDemoRow[] = Array.from({ length: 32 }, (_, index) => ({
+  id: `row-${index + 1}`,
+  label: `Row ${index + 1}`,
+}));
+export function useNbDemo(): {
+  tab: string;
+  setTab: Dispatch<SetStateAction<string>>;
+  modalOpen: boolean;
+  openModal: () => void;
+  closeModal: () => void;
+  value: number;
+  increment: () => void;
+  rows: readonly NbDemoRow[];
+  reverseRows: () => void;
+  toggleLarge: () => void;
+} {
+  const [tab, setTab] = useState("overview");
+  const [modalOpen, setModalOpen] = useState(false);
+  const [value, setValue] = useState(0);
+  const [large, setLarge] = useState(false);
+  const [reversed, setReversed] = useState(false);
+  const rows = useMemo(() => {
+    const source = large ? LARGE_ROWS : SMALL_ROWS;
+    return reversed ? [...source].reverse() : source;
+  }, [large, reversed]);
+  const openModal = useCallback(() => setModalOpen(true), []);
+  const closeModal = useCallback(() => setModalOpen(false), []);
+  const increment = useCallback(() => setValue((current) => current + 1), []);
+  const reverseRows = useCallback(() => setReversed((current) => !current), []);
+  const toggleLarge = useCallback(() => setLarge((current) => !current), []);
+  return { tab, setTab, modalOpen, openModal, closeModal, value, increment, rows, reverseRows, toggleLarge };
+}
