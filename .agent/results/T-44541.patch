+++ b/frontend/components/pages/steward-records.tsx
@@ -0,0 +1,84 @@
+"use client";
+
+import type { useStewardDesk } from "@/lib/use-steward-desk";
+import { NbBadge } from "@/components/nb/badge";
+import { NbButton } from "@/components/nb/button";
+import { NbCard } from "@/components/nb/card";
+import { NbState } from "@/components/nb/state";
+import { NbTable } from "@/components/nb/table";
+import type { ViewState } from "@/lib/data-state";
+import type { StewardLicence, StewardPenalty } from "@/lib/use-stewarding-records";
+
+type Records = ReturnType<typeof useStewardDesk>["records"];
+
+function stateFor<T>(source: Records["penalties"] | Records["licences"], data: readonly T[]): ViewState<readonly T[]> {
+  if (source.loading && !source.loaded) return { status: "loading" };
+  if (source.error && data.length === 0) return { status: "error", error: { message: source.error, retryable: true }, retry: source.reload };
+  if (source.loaded && data.length === 0) return { status: "empty", reason: "no-data" };
+  if (data.length > 0 && (source.error || source.loading)) return { status: "partial", data, filter: { label: "refresh records", clear: source.reload }, totalCount: data.length };
+  return { status: "populated", data };
+}
+
+function Pager({ source, label }: { source: Records["penalties"] | Records["licences"]; label: string }) {
+  const range = source.rows.length
+    ? `${source.offset + 1}–${source.offset + source.rows.length} returned`
+    : source.loaded ? "0 returned" : source.error ? "Records unavailable" : "Loading records…";
+  return <div className="flex min-w-0 flex-wrap items-center justify-between gap-3 border-t-4 border-ink pt-4">
+    <p className="font-mono text-sm tabular-nums" aria-live="polite">{range}</p>
+    <div className="flex flex-wrap gap-3">
+      <NbButton variant="secondary" disabled={source.loading || source.offset === 0} aria-label={`Previous ${label} page`} onClick={source.previous}>Previous</NbButton>
+      <NbButton variant="secondary" disabled={source.loading || !source.hasNext} aria-label={`Next ${label} page`} onClick={source.next}>Next</NbButton>
+    </div>
+  </div>;
+}
+
+const penaltyColumns = [
+  { key: "id", title: "Penalty ID" }, { key: "incident_id", title: "Incident ID" },
+  { key: "driver_name", title: "Driver", render: (row: StewardPenalty) => row.driver_name || row.driver_id },
+  { key: "driver_id", title: "Driver ID" }, { key: "session_id", title: "Session ID" },
+  { key: "lap", title: "Lap", numeric: true }, { key: "points", title: "Points", numeric: true },
+  { key: "time_seconds", title: "Time (seconds)", numeric: true }, { key: "grid_places", title: "Grid places", numeric: true },
+  { key: "created_at", title: "Recorded at" },
+];
+
+function Penalties({ source }: { source: Records["penalties"] }) {
+  const state = stateFor(source, source.rows);
+  return <NbCard tone="cream" className="min-w-0" role="region" aria-label="Penalties and sanctions">
+    <h2 className="mb-4 text-xl font-bold">Penalties and sanctions</h2>
+    <NbTable state={state} columns={penaltyColumns} rowKey={(row) => row.id} caption="Official penalty and sanction history" empty="No official penalties or sanctions have been recorded." pageSize={3} partialSummary={`Showing ${source.rows.length} penalty records while ${source.error ? "the refresh has failed" : "refreshing"}.`} partialActionLabel="Retry penalties" partialActionAriaLabel="Retry penalties" sourceMessage={source.error || (source.loading && source.rows.length > 0 ? "Refreshing penalty history…" : undefined)} />
+    <Pager source={source} label="penalties" />
+  </NbCard>;
+}
+
+function LicenceMeter({ licence }: { licence: StewardLicence }) {
+  const value = Math.max(0, Math.min(12, licence.points));
+  const owner = licence.driver_name || licence.licence_number;
+  return <li className="min-w-0 border-4 border-ink bg-paper p-4 shadow-nb-4">
+    <div className="flex min-w-0 flex-wrap items-start justify-between gap-3">
+      <div className="min-w-0"><h3 className="break-words font-bold">{owner}</h3><p className="break-all font-mono text-sm">Licence {licence.licence_number}</p></div>
+      <NbBadge status={licence.eligibility}>{licence.eligibility}</NbBadge>
+    </div>
+    <p className="mt-3 text-sm">Season {licence.season} · {licence.points} points</p>
+    <div className="mt-3 grid grid-cols-6 gap-2 sm:grid-cols-12" role="meter" aria-label={`${owner} licence points`} aria-valuemin={0} aria-valuemax={12} aria-valuenow={value} aria-valuetext={`${licence.points} points in season ${licence.season}`}>
+      {Array.from({ length: 12 }, (_, index) => <span key={index} aria-hidden="true" className={`h-4 border-2 border-ink ${index < value ? "bg-red" : "bg-paper"}`} />)}
+    </div>
+  </li>;
+}
+
+function Licences({ source }: { source: Records["licences"] }) {
+  const state = stateFor(source, source.rows);
+  return <NbCard tone="cream" className="min-w-0" role="region" aria-label="Licence points">
+    <h2 className="mb-4 text-xl font-bold">Licence points</h2>
+    <NbState state={state} empty={`No licence records were returned for season ${source.season}.`} loadingLabel="Loading licence points" skeletonRows={3} partialSummary={`Showing ${source.rows.length} licence records while ${source.error ? "the refresh has failed" : "refreshing"}.`} partialActionLabel="Retry licences" partialActionAriaLabel="Retry licences" sourceMessage={source.error || (source.loading && source.rows.length > 0 ? "Refreshing licence points…" : undefined)}>
+      {(rows) => <ul className="grid min-w-0 grid-cols-1 gap-4 lg:grid-cols-2">{rows.map((licence) => <LicenceMeter key={licence.driver_id || licence.licence_number} licence={licence} />)}</ul>}
+    </NbState>
+    <Pager source={source} label="licences" />
+  </NbCard>;
+}
+
+export function StewardRecords({ records }: { records: Records }) {
+  return <section aria-label="Official stewarding records" className="mb-8 grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-2">
+    <Penalties source={records.penalties} />
+    <Licences source={records.licences} />
+  </section>;
+}
