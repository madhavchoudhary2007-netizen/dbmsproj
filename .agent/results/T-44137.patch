diff --git a/backend/app/token_revocation.py b/backend/app/token_revocation.py
new file mode 100644
index 0000000..65b68e8
--- /dev/null
+++ b/backend/app/token_revocation.py
@@ -0,0 +1,30 @@
+from datetime import datetime
+from uuid import NAMESPACE_URL, UUID, uuid5
+
+from .database import connection, fetch_one
+
+
+def revocation_key(jti: str) -> UUID:
+    return uuid5(NAMESPACE_URL, "apexgrid.jwt:" + jti)
+
+
+def is_revoked(jti: str) -> bool:
+    row = fetch_one(
+        "SELECT jti FROM revoked_tokens WHERE jti = %s AND expires_at >= now()",
+        (revocation_key(jti),),
+    )
+    return row is not None
+
+
+def revoke_token(jti: str, expires_at: datetime) -> None:
+    with connection() as conn, conn.cursor() as cur:
+        cur.execute(
+            "INSERT INTO revoked_tokens (jti, expires_at) VALUES (%s, %s) "
+            "ON CONFLICT (jti) DO NOTHING",
+            (revocation_key(jti), expires_at),
+        )
+
+
+def purge_expired_revocations() -> None:
+    with connection() as conn, conn.cursor() as cur:
+        cur.execute("DELETE FROM revoked_tokens WHERE expires_at < now()")
diff --git a/backend/migrations/004_token_revocation.sql b/backend/migrations/004_token_revocation.sql
new file mode 100644
index 0000000..18f7dcf
--- /dev/null
+++ b/backend/migrations/004_token_revocation.sql
@@ -0,0 +1,7 @@
+CREATE TABLE IF NOT EXISTS revoked_tokens (
+    jti uuid PRIMARY KEY,
+    expires_at timestamptz NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS revoked_tokens_expires_at_idx
+    ON revoked_tokens (expires_at);
