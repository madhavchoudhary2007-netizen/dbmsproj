+
+test("refresh failure retains rows and retry restores populated state", async ({ page }) => {
+  let failRefresh = false;
+  const writes = await mockApi(page, async (route) => {
+    if (failRefresh) {
+      await route.fulfill({ status: 503, json: { detail: "Refresh unavailable" } });
+    } else {
+      await route.fulfill({ status: 200, json: [row(9, "Retained championship")] });
+    }
+  });
+
+  await page.goto("/championships");
+  const main = page.getByRole("main");
+  await expect(main.getByTestId("state-populated")).toBeVisible();
+  const retainedCell = main.getByRole("cell", { name: "Retained championship" });
+  await expect(retainedCell).toBeVisible();
+  failRefresh = true;
+  await main.getByRole("button", { name: "Refresh", exact: true }).click();
+  await expect(main.getByTestId("state-partial")).toBeVisible();
+  await expect(main.getByTestId("state-partial")).toContainText("Refresh unavailable");
+  await expect(retainedCell).toBeVisible();
+  failRefresh = false;
+  await main.getByRole("button", { name: "Try again", exact: true }).click();
+  await expect(main.getByTestId("state-populated")).toBeVisible();
+  await expect(retainedCell).toBeVisible();
+  expect(writes).toEqual([]);
+});
+
+test("clearing a filtered partial view restores the first page", async ({ page }) => {
+  const rows = Array.from({ length: 51 }, (_, index) => row(index + 1));
+  const writes = await mockApi(page, async (route) => {
+    await route.fulfill({ status: 200, json: rows });
+  });
+
+  await page.goto("/championships");
+  const main = page.getByRole("main");
+  const table = main.locator("table");
+  await main.getByRole("button", { name: "Next", exact: true }).click();
+  await expect(main.locator(".resource-range")).toHaveText("Showing 51–51 of 51");
+  const filter = page.getByLabel("Filter records");
+  await filter.fill("Championship 51");
+  await expect(main.getByTestId("state-partial")).toBeVisible();
+  await expect(main.getByRole("cell", { name: "Championship 51" })).toBeVisible();
+  await expect(main.locator(".resource-range")).toHaveText("Showing 1–1 of 1");
+  await main.getByRole("button", { name: "Clear filter", exact: true }).click();
+  await expect(filter).toHaveValue("");
+  await expect(main.getByTestId("state-populated")).toBeVisible();
+  await expect(table.locator("tbody tr")).toHaveCount(50);
+  await expect(main.locator(".resource-range")).toHaveText("Showing 1–50 of 51");
+  expect(writes).toEqual([]);
+});
