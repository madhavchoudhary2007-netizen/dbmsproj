diff --git a/frontend/app/styles/login.css b/frontend/app/styles/login.css
index 6d64e8a..aa26ef6 100644
--- a/frontend/app/styles/login.css
+++ b/frontend/app/styles/login.css
@@ -1,4 +1,5 @@
 /* Dormant until the login route opts into .nb-login. */
+html:has(.nb-login), body:has(.nb-login) { color-scheme: light; background: var(--nb-cream, #FFFDF5); color: var(--nb-ink, #000000); }
 .nb-login.login-screen { min-width: 0; overflow: hidden; grid-template-columns: 60% 40%; gap: 0; background: var(--nb-cream, #FFFDF5); }
 .nb-login .login-visual { min-width: 0; border: 4px solid var(--nb-ink, #000000); }
 .nb-login .login-visual { position: relative; isolation: isolate; overflow: hidden; padding: 32px; background: var(--nb-cream, #FFFDF5); border-inline-end: 0; }
@@ -27,6 +28,10 @@
 .nb-login .login-form h1 { margin: 8px 0; font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); line-height: 1.2; }
 .nb-login .eyebrow { color: var(--nb-ink, #000000); }
 .nb-login .login-submit .nb-face { color: var(--nb-ink, #000000); }
+@media (min-width: 1000px) {
+  .nb-login .nb-login-art-row { flex-wrap: wrap; row-gap: 16px; }
+  .nb-login .nb-login-marquee { flex: 1 1 100%; width: 100%; min-height: 64px; align-items: center; }
+}
 @media (max-width: 999px) {
   .nb-login.login-screen { grid-template-columns: 1fr; }
   .nb-login .login-visual { min-height: 240px; height: 240px; padding: 16px; border-inline-end: 4px solid var(--nb-ink, #000000); border-block-end: 0; }
