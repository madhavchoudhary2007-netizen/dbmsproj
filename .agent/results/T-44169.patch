diff --git a/scripts/eval/neo_weight.py b/scripts/eval/neo_weight.py
new file mode 100644
index 0000000..0c320fc
--- /dev/null
+++ b/scripts/eval/neo_weight.py
@@ -0,0 +1,147 @@
+import re
+import sys
+from pathlib import Path
+
+from scripts.eval.source_text import mask_comments
+
+CSS_DECL = re.compile(r"(?<![\w-])(?P<key>font-weight|font)\s*:\s*(?P<value>[^;{}]+)", re.I)
+JS_DECL = re.compile(
+    r"(?<=[{,])\s*(?P<key>['\"]?(?:fontWeight|font)['\"]?)\s*:\s*(?P<value>"
+    r"['\"][^'\"]*['\"]|900\b)",
+    re.I,
+)
+WEIGHT = re.compile(r"(?<![\w.])900(?![\w.])")
+FONT_SIZE = re.compile(
+    r"(?<![\w.-])(?:\d+(?:\.\d+)?(?:px|rem|em|%|vh|vw|pt|pc|cm|mm|in|ex|ch|lh|rlh)|"
+    r"xx-small|x-small|small|medium|large|x-large|xx-large|xxx-large|smaller|larger)"
+    r"(?:\s*/[^\s]+)?",
+    re.I,
+)
+TAILWIND = re.compile(r"(?<![\w-])(?:[\w-]+:)*(?:font-black|font-\[900\])(?![\w-])")
+CLASS_CONTEXT = re.compile(r"(?:class(?:Name)?\s*=|\b(?:clsx|classnames|cn|cva)\s*\()\s*$", re.I)
+
+
+def _in_string(text: str, offset: int) -> bool:
+    quote = ""
+    escaped = False
+    for char in text[:offset]:
+        if escaped:
+            escaped = False
+        elif quote and char == "\\":
+            escaped = True
+        elif quote and char == quote:
+            quote = ""
+        elif not quote and char in "'\"`":
+            quote = char
+    return bool(quote)
+
+
+def _weight_in_value(value: str) -> int | None:
+    match = WEIGHT.search(value)
+    return None if match is None else match.start()
+
+
+def _shorthand_weight(value: str) -> int | None:
+    size = FONT_SIZE.search(value)
+    match = WEIGHT.search(value[: size.start()] if size else "")
+    return None if match is None else match.start()
+
+
+def check_weight(text: str, css: bool = False) -> list[tuple[int, str]]:
+    """Return offsets for forbidden 900 weights, preserving source offsets."""
+    clean = mask_comments(text, css=css)
+    hits: set[tuple[int, str]] = set()
+    for pattern in (CSS_DECL, JS_DECL):
+        for match in pattern.finditer(clean):
+            key_start = match.start("key")
+            if _in_string(clean, key_start):
+                continue
+            value = match.group("value").strip("'\"")
+            key = match.group("key").strip("'\"").lower().replace("-", "")
+            weight = _weight_in_value(value) if key == "fontweight" else _shorthand_weight(value)
+            if weight is not None:
+                value_start = match.start("value")
+                quote_offset = 1 if clean[value_start : value_start + 1] in "'\"" else 0
+                hits.add((value_start + quote_offset + weight, "900 font weight"))
+    for match in TAILWIND.finditer(clean):
+        if not _in_string(clean, match.start()):
+            continue
+        opening = max(clean.rfind("'", 0, match.start()), clean.rfind('"', 0, match.start()))
+        prefix = clean[max(0, opening - 200) : opening]
+        conditional_class = re.search(r"class(?:Name)?\s*=\s*\{[^{}]*$", prefix, re.I)
+        if CLASS_CONTEXT.search(prefix) or conditional_class:
+            hits.add((match.start(), "900 font weight"))
+    return sorted(hits)
+
+
+def _self_test() -> int:
+    root = Path(__file__).with_name("rules")
+    good = (root / "weight.good.css").read_text()
+    bad = (root / "weight.bad.css").read_text()
+    assertions = 0
+
+    def expect(source: str, css: bool, found: bool) -> None:
+        nonlocal assertions
+        assertions += 1
+        if bool(check_weight(source, css)) != found:
+            raise AssertionError(f"unexpected weight lint result for {source!r}")
+
+    expect(good, True, False)
+    expect(bad, True, True)
+    for source in (
+        "a{font-weight:900}",
+        "a{font:900 1rem/1.5 sans-serif}",
+        "a{font:16px/900 sans-serif}",
+        "a{font-weight:700}",
+        "a{font:500 1rem sans-serif}",
+        "a{font-weight:400}",
+        "a{width:900px}",
+        "a{content:'900'}",
+        "a{background:url('900')}",
+        "/* font-weight:900 */ a{font-weight:700}",
+        "const x={fontWeight:900}",
+        "const x={'fontWeight':'900'}",
+        'const x={"fontWeight":900}',
+        'const x={fontWeight:"900"}',
+        "const x={fontWeight:'700'}",
+        "const x={font:'900 16px serif'}",
+        "const x={fontWeight:500}",
+        "const x={value:900}",
+        "const x={fontFamily:'900 serif'}",
+        "const x='fontWeight:900 prose'",
+        "const x='https://x.test/900'",
+        "// fontWeight:900\nconst x={fontWeight:400}",
+        '<div className="hover:font-black" />',
+        '<div class="sm:font-[900]" />',
+        '<div className={clsx("focus:font-black")} />',
+        '<div className="font-medium" />',
+        'const x="font-black in prose"',
+        'const text="{fontWeight:900}"',
+        '<div className={busy ? "font-black" : "font-bold"} />',
+    ):
+        expect(
+            source,
+            "a{" in source,
+            source
+            in {
+                "a{font-weight:900}",
+                "a{font:900 1rem/1.5 sans-serif}",
+                "const x={fontWeight:900}",
+                "const x={'fontWeight':'900'}",
+                'const x={"fontWeight":900}',
+                'const x={fontWeight:"900"}',
+                "const x={font:'900 16px serif'}",
+                '<div className="hover:font-black" />',
+                '<div class="sm:font-[900]" />',
+                '<div className={clsx("focus:font-black")} />',
+                '<div className={busy ? "font-black" : "font-bold"} />',
+            },
+        )
+    print(f"neo_weight self-test: {assertions} assertions passed")
+    return assertions
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2 or sys.argv[1] != "--self-test":
+        raise SystemExit("usage: neo_weight.py --self-test")
+    _self_test()
