# Run from the project root. Database integration tests use DATABASE_URL and MONGODB_URL when set.
export INSTALL_CMD="npm --prefix frontend ci && .venv/bin/python -m pip install -r backend/requirements.txt -r backend/requirements-dev.txt"
export TYPECHECK_CMD="npm --prefix frontend run typecheck"
export LINT_CMD="npm --prefix frontend run lint"
export TEST_CMD=".venv/bin/pytest -q backend/tests"
export TEST_ONE_CMD=".venv/bin/pytest -q"  # append a test file path
export E2E_CMD="none"
export BUILD_CMD="npm --prefix frontend run build"
export RUFF_CMD=".venv/bin/ruff check backend/app backend/tests && .venv/bin/ruff format --check backend/app backend/tests"
export MYPY_CMD=".venv/bin/mypy --strict backend/app"
export COVERAGE_CMD=".venv/bin/pytest -q --cov=backend/app --cov-report=term-missing backend/tests"
export FRONTEND_LINT_CMD="npm --prefix frontend run lint -- --max-warnings 0"
export AUDIT_CMD=".venv/bin/pip-audit -r backend/requirements.txt && npm --prefix frontend audit --audit-level=high"
export SRC_DIRS="frontend/app frontend/components frontend/lib"
export PRODUCT_DIRS="frontend backend"
