# Run from the project root. Database integration tests use DATABASE_URL and MONGODB_URL when set.
export INSTALL_CMD="npm --prefix frontend ci && .venv/bin/python -m pip install -r backend/requirements.txt -r backend/requirements-dev.txt"
export TYPECHECK_CMD="npm --prefix frontend run typecheck"
export LINT_CMD="npm --prefix frontend run lint"
export TEST_CMD=".venv/bin/pytest -q backend/tests"
export TEST_ONE_CMD=".venv/bin/pytest -q"  # append a test file path
export E2E_CMD="none"
export BUILD_CMD="npm --prefix frontend run build"
