# Source at every session start. HARNESS selects the profile:
#   HARNESS=codex source .agent/models.env      (default: claude)
# Names below are the intended models; use the exact ID your account lists (docs show IDs like gpt-6.1-sol).
export HARNESS="${HARNESS:-codex}"    # claude | codex | gemini | antigravity
export MAX_WORKERS=2                  # workers running at the same time, on every harness
export CONTEXT_WINDOW=400000          # auto-compact point in tokens (harness setting must equal this; boot.sh checks)

case "$HARNESS" in
  claude)
    export ORCH_MODEL="sonnet";            export ORCH_EFFORT="medium"   # Sonnet 5.5, effort
    export WORKER_MODEL="haiku";           export WORKER_EFFORT="high" ;;  # Haiku 5.5, effort
  codex)
    export ORCH_MODEL="gpt-6-sol";         export ORCH_EFFORT="medium"   # reasoning effort
    export WORKER_MODEL="gpt-6-luna";      export WORKER_EFFORT="high" ;;
  gemini|antigravity)
    export ORCH_MODEL="gemini-3.8-flash";  export ORCH_EFFORT="high"     # thinking level
    export WORKER_MODEL="gemini-3.8-flash"; export WORKER_EFFORT="low" ;;
  *) echo "unknown HARNESS: $HARNESS" >&2 ;;
esac
